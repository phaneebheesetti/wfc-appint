# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SHORT_LINK="https://tinyurl.com/wfcfrapp-stg"
NEXT_PUBLIC_DEMO_SOCIAL_PROOF="true"
NEXT_PUBLIC_TERMS_AND_CONDITIONS_ENABLED="true"
NEXT_PUBLIC_FF_LABEL_CHANGE="true"
NEXT_PUBLIC_FF_INVENTORY_PRODUCT_UPDATES=

# Drizzle ORM
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DATABASE_MIGRATIONS_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/accept-invitation"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/accept-invitation"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ROLE_SESSION_SECRET=

# Sentry
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_DEBUG="false"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE="0.1"

# Stripe
STRIPE_SECRET_KEY="sk_"
STRIPE_WEBHOOK_SECRET="whsec_"
STRIPE_PUBLIC_KEY="pk_"
STRIPE_VERSION="2023-10-16"
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_"
STRIPE_RESTRICTION_CHECK=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Handwriting OCR
HANDWRITING_OCR_API_KEY=

# Sendgrid
SENDGRID_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Ably
NEXT_PUBLIC_ABLY_API_KEY=

# Salesforce
SF_LOGIN_URL="https://test.salesforce.com" #Sandbox
SF_USERNAME=
SF_PASSWORD=

# Nightly jobs (e.g. scripts/organization-sync.ts)
# Set to "false" to stop sending the status email on every run.
NIGHTLY_JOBS_EMAIL_NOTIFICATIONS_ENABLED="true"
