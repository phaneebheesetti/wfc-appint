{
  "name": "wfc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "clear": "rimraf .next",
    "start": "next start",
    "dev": "next dev --turbo",
    "dev-webpack": "yarn clear && next dev --webpack",
    "build": "next build",
    "preview": "next build && next start",
    "db:generate": "npx dotenv-cli -o -- npx drizzle-kit generate",
    "db:migrate": "npx dotenv-cli -o -- npx drizzle-kit migrate",
    "db:seed": "npx dotenv-cli -o -- npx tsx src/server/db/seed.ts",
    "db:setup-user": "npx dotenv-cli -o -- npx tsx src/server/db/setup.ts",
    "script:clerk-delete-inactive-users": "npx tsx scripts/clerk-delete-inactive-users.ts",
    "script:clerk-export-corrupted-users": "npx tsx scripts/clerk-export-corrupted-users.ts",
    "script:clerk-export-inactive-users": "npx tsx scripts/clerk-export-inactive-users.ts",
    "script:clerk-fix-corrupted-users": "npx tsx scripts/clerk-fix-corrupted-users.ts",
    "script:delete-users-by-email": "npx tsx scripts/delete-users-by-email.ts",
    "script:register-payment-method-domains": "npx tsx scripts/register-payment-method-domains.ts",
    "script:participant-access-notifications": "npx tsx scripts/participant-access-notifications.ts",
    "script:bulk-invite-users": "npx tsx scripts/bulk-invite-users.cts",
    "script:bulk-create-organizations": "npx tsx scripts/bulk-create-organizations.cts",
    "script:merge-organizations": "npx tsx scripts/merge-organizations.ts",
    "script:fetch-jira-issue": "npx tsx scripts/fetch-jira-issue.ts",
    "script:organization-sync": "npx tsx scripts/organization-sync.ts",
    "script:digital-payments-report": "npx tsx scripts/digital-payments-report.ts",
    "script:fc-report": "npx tsx scripts/fc-report.ts",
    "script:backfill-prize-template-name": "npx tsx scripts/backfill-prize-template-name.ts",
    "typecheck": "tsc --noEmit --incremental",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "email:dev": "npx dotenv-cli -o -- email dev --port 3001 --dir src/components/emails",
    "email:export": "npx dotenv-cli -o -- email export --dir src/components/emails",
    "e2e:install": "playwright install",
    "e2e:install:ci": "playwright install chromium",
    "e2e:test": "npx dotenv-cli -o -- playwright test",
    "e2e:test:ci": "playwright test",
    "e2e:test:ui": "npx dotenv-cli -o -- playwright test --ui",
    "prepare": "husky",
    "clean": "rm -rf .next",
    "heroku-cleanup": "rm -rf .next/cache"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mdx}": [
      "prettier --write --cache",
      "eslint --fix"
    ]
  },
